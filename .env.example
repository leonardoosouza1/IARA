# Database (TimescaleDB / Postgres)
POSTGRES_USER=saci
POSTGRES_PASSWORD=saci_secret
POSTGRES_DB=saci_core
POSTGRES_HOST=db
POSTGRES_PORT=5432

# S3 / MinIO
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio123
MINIO_ENDPOINT=http://minio:9000
AWS_ACCESS_KEY_ID=minio
AWS_SECRET_ACCESS_KEY=minio123

# MLflow
MLFLOW_BACKEND_STORE_URI=postgresql://saci:saci_secret@db:5432/mlflow
MLFLOW_ARTIFACT_ROOT=s3://mlflow/

# Application
# DB_URI is used by the application logic
DB_URI=postgresql://saci:saci_secret@db:5432/saci_core
OLLAMA_URL=http://ollama:11434/api/generate
